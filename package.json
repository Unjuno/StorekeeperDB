{
  "name": "@storekeeper/db",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "private": false,
  "description": "Magic persistent TypeScript state for fast-changing prototypes, backed by SQLite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unjuno/StorekeeperDB.git"
  },
  "bugs": {
    "url": "https://github.com/Unjuno/StorekeeperDB/issues"
  },
  "homepage": "https://github.com/Unjuno/StorekeeperDB#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-sqlite --test dist/test/*.test.js",
    "test:react": "npm run build && node --experimental-sqlite --test dist/test/react.test.js",
    "gate": "npm run build && node --experimental-sqlite dist/scripts/gate.js",
    "demo": "npm run build && node --experimental-sqlite dist/scripts/demo.js",
    "demo:check": "node --experimental-sqlite dist/scripts/demo.js",
    "benchmark": "npm run build && node --experimental-sqlite dist/scripts/benchmark.js",
    "benchmark:check": "node --experimental-sqlite dist/scripts/benchmark.js",
    "consumer:smoke": "node --experimental-sqlite scripts/consumer_smoke.mjs",
    "check:exports": "node dist/scripts/release_check.js",
    "pack:dry": "npm pack --dry-run",
    "release:check": "npm run build && npm test && npm run gate && npm run demo:check && npm run check:exports && npm run pack:dry && npm run consumer:smoke"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-test-renderer": "^19.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./core": {
      "types": "./dist/src/core.d.ts",
      "import": "./dist/src/core.js"
    },
    "./node": {
      "types": "./dist/src/node.d.ts",
      "import": "./dist/src/node.js"
    },
    "./react": {
      "types": "./dist/src/react.d.ts",
      "import": "./dist/src/react.js"
    },
    "./experimental": {
      "types": "./dist/src/experimental.d.ts",
      "import": "./dist/src/experimental.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ]
}
