{
  "name": "@storekeeper/db",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "private": false,
  "description": "Magic persistent TypeScript state for fast-changing prototypes, backed by SQLite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unjuno/StorekeeperDB.git"
  },
  "bugs": {
    "url": "https://github.com/Unjuno/StorekeeperDB/issues"
  },
  "homepage": "https://github.com/Unjuno/StorekeeperDB#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-sqlite --test dist/test/*.test.js",
    "test:react": "npm run build && node --experimental-sqlite --test dist/test/react.test.js",
    "gate": "npm run build && node --experimental-sqlite dist/scripts/gate.js",
    "demo": "npm run build && node --experimental-sqlite dist/scripts/demo.js",
    "demo:check": "node --experimental-sqlite dist/scripts/demo.js",
    "benchmark": "npm run build && node --experimental-sqlite dist/scripts/benchmark.js",
    "benchmark:check": "node --experimental-sqlite dist/scripts/benchmark.js",
    "experiment:durable-session": "npm run build && node --experimental-sqlite dist/scripts/durable_session_experiment.js",
    "experiment:durable-session:check": "node --experimental-sqlite dist/scripts/durable_session_experiment.js",
    "experiment:change-amplification": "npm run build && node --experimental-sqlite dist/scripts/change_amplification_experiment.js",
    "experiment:change-amplification:check": "node --experimental-sqlite dist/scripts/change_amplification_experiment.js",
    "experiment:cli-change-amplification": "npm run build && node --experimental-sqlite dist/scripts/cli_metadata_change_amplification_experiment.js",
    "experiment:cli-change-amplification:check": "node --experimental-sqlite dist/scripts/cli_metadata_change_amplification_experiment.js",
    "experiment:root-state-semantics": "npm run build && node --experimental-sqlite dist/scripts/root_state_semantics_experiment.js",
    "experiment:root-state-semantics:check": "node --experimental-sqlite dist/scripts/root_state_semantics_experiment.js",
    "experiment:singleton-object-surface": "npm run build && node --experimental-sqlite dist/scripts/singleton_object_surface_experiment.js",
    "experiment:singleton-object-surface:check": "node --experimental-sqlite dist/scripts/singleton_object_surface_experiment.js",
    "experiment:agent-decision-burden": "npm run build && node --experimental-sqlite dist/scripts/agent_decision_burden_experiment.js",
    "experiment:agent-decision-burden:check": "node --experimental-sqlite dist/scripts/agent_decision_burden_experiment.js",
    "experiment:agent-project-convention": "npm run build && node --experimental-sqlite dist/scripts/agent_project_convention_experiment.js",
    "experiment:agent-project-convention:check": "node --experimental-sqlite dist/scripts/agent_project_convention_experiment.js",
    "experiment:declaration-key-rename": "npm run build && node --experimental-sqlite dist/scripts/declaration_key_rename_experiment.js",
    "experiment:declaration-key-rename:check": "node --experimental-sqlite dist/scripts/declaration_key_rename_experiment.js",
    "experiment:collection-rename-projection": "npm run build && node --experimental-sqlite dist/scripts/collection_rename_projection_experiment.js",
    "experiment:collection-rename-projection:check": "node --experimental-sqlite dist/scripts/collection_rename_projection_experiment.js",
    "experiment:multi-step-declaration-rename": "npm run build && node --experimental-sqlite dist/scripts/multi_step_declaration_rename_experiment.js",
    "experiment:multi-step-declaration-rename:check": "node --experimental-sqlite dist/scripts/multi_step_declaration_rename_experiment.js",
    "experiment:state-split-merge-boundary": "npm run build && node --experimental-sqlite dist/scripts/state_split_merge_boundary_experiment.js",
    "experiment:state-split-merge-boundary:check": "node --experimental-sqlite dist/scripts/state_split_merge_boundary_experiment.js",
    "experiment:state-merge-boundary": "npm run build && node --experimental-sqlite dist/scripts/state_merge_boundary_experiment.js",
    "experiment:state-merge-boundary:check": "node --experimental-sqlite dist/scripts/state_merge_boundary_experiment.js",
    "experiment:scalar-to-object-evolution": "npm run build && node --experimental-sqlite dist/scripts/scalar_to_object_value_evolution_experiment.js",
    "experiment:scalar-to-object-evolution:check": "node --experimental-sqlite dist/scripts/scalar_to_object_value_evolution_experiment.js",
    "experiment:enum-narrowing-evolution": "npm run build && node --experimental-sqlite dist/scripts/enum_narrowing_value_evolution_experiment.js",
    "experiment:enum-narrowing-evolution:check": "node --experimental-sqlite dist/scripts/enum_narrowing_value_evolution_experiment.js",
    "experiment:required-field-evolution": "npm run build && node --experimental-sqlite dist/scripts/required_field_value_evolution_experiment.js",
    "experiment:required-field-evolution:check": "node --experimental-sqlite dist/scripts/required_field_value_evolution_experiment.js",
    "experiment:migration-marker": "npm run build && node --experimental-sqlite dist/scripts/migration_idempotency_marker_experiment.js",
    "experiment:migration-marker:check": "node --experimental-sqlite dist/scripts/migration_idempotency_marker_experiment.js",
    "check:migration-marker-docs": "node dist/scripts/migration_marker_release_check.js",
    "scenario:issue-tracker": "npm run build && node --experimental-sqlite dist/scripts/issue_tracker_scenario.js",
    "scenario:issue-tracker:check": "node --experimental-sqlite dist/scripts/issue_tracker_scenario.js",
    "consumer:smoke": "node --experimental-sqlite scripts/consumer_smoke.mjs",
    "check:exports": "node dist/scripts/release_check.js",
    "pack:dry": "npm pack --dry-run",
    "release:check": "npm run build && npm test && npm run gate && npm run demo:check && npm run experiment:durable-session:check && npm run experiment:change-amplification:check && npm run experiment:cli-change-amplification:check && npm run experiment:root-state-semantics:check && npm run experiment:singleton-object-surface:check && npm run experiment:agent-decision-burden:check && npm run experiment:agent-project-convention:check && npm run experiment:declaration-key-rename:check && npm run experiment:collection-rename-projection:check && npm run experiment:multi-step-declaration-rename:check && npm run experiment:state-split-merge-boundary:check && npm run experiment:state-merge-boundary:check && npm run experiment:scalar-to-object-evolution:check && npm run experiment:enum-narrowing-evolution:check && npm run experiment:required-field-evolution:check && npm run experiment:migration-marker:check && npm run scenario:issue-tracker:check && npm run check:exports && npm run check:migration-marker-docs && npm run pack:dry && npm run consumer:smoke"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-test-renderer": "^19.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./core": {
      "types": "./dist/src/core.d.ts",
      "import": "./dist/src/core.js"
    },
    "./node": {
      "types": "./dist/src/node.d.ts",
      "import": "./dist/src/node.js"
    },
    "./react": {
      "types": "./dist/src/react.d.ts",
      "import": "./dist/src/react.js"
    },
    "./experimental": {
      "types": "./dist/src/experimental.d.ts",
      "import": "./dist/src/experimental.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ]
}
